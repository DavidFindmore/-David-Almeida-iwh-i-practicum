html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    .form-wrapper
      a(href="/") Return to the homepage
      h1 Add a new Car
      form(method="POST" action="/update-cobj")
        label Brand Name
        input(type="text" name="brand_name")
        label Engine Displacement
        input(type="text" name="fm_car_engine_displacement")
        label Price
        input(type="text" name="fm_price")
        input(type="submit" value="Submit")