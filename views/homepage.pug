html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    h1 Cars
    a(href="/update-cobj") Add to this table
    .cards
      each record in data
        .card
          p.card__email Brand: #{record.properties.brand_name}
          p Engine: #{record.properties.fm_car_engine_displacement}
          p Price: #{record.properties.fm_price}€